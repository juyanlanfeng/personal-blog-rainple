        {palette.map((color) => (
          <div data-card="" style="border-radius:22px; overflow:hidden; background:#fff; box-shadow:0 14px 32px rgba(76,130,170,.12);" style-hover="transform:translateY(-6px); box-shadow:0 22px 44px rgba(76,130,170,.2);">
            <div style={`height:120px; background:${color.hex};`}></div>
            <div style="padding:16px 18px;">
              <div style="font-weight:700; font-size:16px; color:var(--ink);">{color.name}</div>
              <div style="font-family:'Fredoka',sans-serif; font-size:13px; color:var(--ink-soft); letter-spacing:1px;">{color.hex}</div>
              <div style="font-size:12px; color:var(--ink-soft); margin-top:4px;">{color.use}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- features + traits：左边“外观特征”列表，右边“性格”标签云，左宽右窄 -->
      <div style="margin-top:clamp(36px,5vw,60px); display:grid; grid-template-columns:1.25fr .75fr; gap:clamp(24px,4vw,48px); align-items:start;">
        <!-- 左边：外观特征 -->
        <div data-reveal="">
          <h3 style="font-family:'ZCOOL KuaiLe',cursive; font-size:24px; color:var(--ink); margin:0 0 18px;">外观特征 · Features</h3>
          <!-- 特征卡片网格：2列 -->
          <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:14px;">
            {features.map((feature) => (
              <div data-card="" style="display:flex; gap:14px; padding:18px; border-radius:18px; background:#fff; box-shadow:0 10px 24px rgba(76,130,170,.1);" style-hover="transform:translateY(-4px);">
                <span style={`flex:none; width:14px; height:14px; margin-top:5px; border-radius:50%; background:${feature.dot}; box-shadow:0 0 0 4px ${feature.glow};`}></span>
                <div>
                  <div style="font-weight:700; font-size:15px; color:var(--ink);">{feature.t}</div>
                  <div style="font-size:13px; color:var(--ink-soft); line-height:1.6; margin-top:3px;">{feature.d}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <!-- 右边：性格标签 -->
        <div data-reveal="">
          <h3 style="font-family:'ZCOOL KuaiLe',cursive; font-size:24px; color:var(--ink); margin:0 0 18px;">性格 · Personality</h3>
          <!-- 性格标签云：自动换行排列 -->
          <div style="display:flex; flex-wrap:wrap; gap:12px;">
            {traits.map((trait) => (
              <span data-card="" style="display:inline-flex; flex-direction:column; align-items:center; gap:2px; padding:13px 20px; border-radius:16px; background:linear-gradient(180deg,#fff,#f4fbff); box-shadow:0 8px 18px rgba(76,130,170,.12);" style-hover="transform:translateY(-4px) rotate(-2deg);">
                <span style="font-family:'ZCOOL KuaiLe',cursive; font-size:18px; color:var(--ink);">{trait.zh}</span>
                <span style="font-family:'Fredoka',sans-serif; font-size:11px; letter-spacing:1px; color:var(--sky-deep);">{trait.en}</span>
              </span>
            ))}
          </div>
          <!-- 性格区下方的引言卡片：渐变背景，引用了一句俏皮话作总结 -->
          <div style="margin-top:24px; padding:20px 22px; border-radius:20px; background:linear-gradient(135deg,var(--sky2),#fdf2e0); box-shadow:inset 0 0 0 1px rgba(255,255,255,.6);">
            <div style="font-family:'ZCOOL KuaiLe',cursive; font-size:17px; color:var(--ink); line-height:1.7;">“喜欢温泉、烤红薯<br>和会发光的小事。”</div>
            <div style="font-family:'Fredoka',sans-serif; font-size:12px; color:var(--ink-soft); margin-top:8px;">loves hot springs, sweet potatoes &amp; little glowing things.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== GALLERY：画作展示区 ===== -->
  <section id="gallery" style="position:relative; padding:clamp(80px,11vw,150px) clamp(20px,5vw,64px); background:#fff;">
    <div style="max-width:1240px; margin:0 auto;">
      <!-- 标题行：左边大标题，右边一句提示语，两端对齐 -->
      <div data-reveal="" style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap;">
        <div>
          <div style="font-family:'Fredoka',sans-serif; font-size:13px; font-weight:600; letter-spacing:4px; color:var(--coral);">ARTWORK · 画作</div>
          <h2 style="margin:14px 0 0; font-family:'ZCOOL KuaiLe',cursive; font-size:clamp(34px,5vw,58px); color:var(--ink);">画师笔下的雨枫</h2>
        </div>
        <div style="font-size:13px; color:var(--ink-soft); max-width:300px; text-align:right;">点击任意一张放大查看 ✦<br><span style="font-family:'Fredoka',sans-serif;">tap any piece to enlarge</span></div>
      </div>

      <!-- 瀑布流画廊容器：column-count:3 把内容分成3栏，类似 Pinterest 的瀑布流布局 -->
      <div data-reveal="" style="margin-top:46px; column-count:3; column-gap:18px;">
        {gallery.featured.map((image) => (
          <figure data-card-fig="" data-src={image.src} data-cap={image.cap} data-en={image.en} style="break-inside:avoid; margin:0 0 18px; border-radius:20px; overflow:hidden; position:relative; cursor:pointer; box-shadow:0 12px 30px rgba(76,130,170,.14); background:#eaf4fb;">
            <img src={image.src} alt={image.cap} loading="lazy" style="width:100%; height:auto; display:block;">
            <figcaption style="position:absolute; left:0; right:0; bottom:0; padding:26px 16px 14px; background:linear-gradient(transparent,rgba(28,46,64,.72)); color:#fff;">
              <div style="font-family:'ZCOOL KuaiLe',cursive; font-size:17px;">{image.cap}</div>
              <div style="font-family:'Fredoka',sans-serif; font-size:11px; letter-spacing:1px; opacity:.85;">{image.en}</div>
            </figcaption>
          </figure>
        ))}
      </div>
      {gallery.more.length > 0 && (
        <div style="text-align:center; margin-top:38px;">
          <a href="/oc/art/" class="rp-more-btn" style="font-family:'Fredoka','Noto Sans SC',sans-serif; font-size:15px; font-weight:600; color:var(--ink); background:#fff; border:2px solid #d8ebf8; border-radius:999px; padding:13px 36px; cursor:pointer; box-shadow:0 8px 22px rgba(76,130,170,.14); display:inline-block; text-decoration:none;">{galleryTotalLabel}</a>
        </div>
      )}
    </div>
  </section>

  <!-- ===== FURSUIT：毛绒玩偶照片区（结构和上面 GALLERY 几乎一样，只是数据源换成毛照） ===== -->
  <section id="fursuit" style="position:relative; padding:clamp(80px,11vw,150px) clamp(20px,5vw,64px); background:linear-gradient(180deg,#ffffff,#eaf6fe);">
    <div style="max-width:1240px; margin:0 auto;">
      <div data-reveal="" style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap;">
        <div>
          <div style="font-family:'Fredoka',sans-serif; font-size:13px; font-weight:600; letter-spacing:4px; color:var(--coral);">FURSUIT · 毛照</div>
          <h2 style="margin:14px 0 0; font-family:'ZCOOL KuaiLe',cursive; font-size:clamp(34px,5vw,58px); color:var(--ink);">现实里的雨枫</h2>
        </div>
        <div style="font-size:13px; color:var(--ink-soft); max-width:320px; text-align:right;">从屏幕跳进现实的小狼龙 ✦<br><span style="font-family:'Fredoka',sans-serif;">the wolfdragon, brought to life</span></div>
      </div>
      <!-- 同样是3栏瀑布流，Astro 在构建时读取精选毛照。 -->
      <div data-reveal="" style="margin-top:46px; column-count:3; column-gap:18px;">
        {furPhotos.featured.map((image) => (
          <figure data-card-fig="" data-src={image.src} data-cap={image.cap} data-en={image.en} style="break-inside:avoid; margin:0 0 18px; border-radius:20px; overflow:hidden; position:relative; cursor:pointer; box-shadow:0 12px 30px rgba(76,130,170,.14); background:#eaf4fb;">
            <img src={image.src} alt={image.cap} loading="lazy" style="width:100%; height:auto; display:block;">
            <figcaption style="position:absolute; left:0; right:0; bottom:0; padding:26px 16px 14px; background:linear-gradient(transparent,rgba(28,46,64,.72)); color:#fff;">
              <div style="font-family:'ZCOOL KuaiLe',cursive; font-size:17px;">{image.cap}</div>
              <div style="font-family:'Fredoka',sans-serif; font-size:11px; letter-spacing:1px; opacity:.85;">{image.en}</div>
            </figcaption>
          </figure>
        ))}
      </div>
      {furPhotos.more.length > 0 && (
        <div style="text-align:center; margin-top:38px;">
          <a href="/oc/fursuit/" class="rp-more-btn" style="font-family:'Fredoka','Noto Sans SC',sans-serif; font-size:15px; font-weight:600; color:var(--ink); background:#fff; border:2px solid #d8ebf8; border-radius:999px; padding:13px 36px; cursor:pointer; box-shadow:0 8px 22px rgba(76,130,170,.14); display:inline-block; text-decoration:none;">{furTotalLabel}</a>
        </div>
      )}
    </div>
  </section>

  <!-- ===== SOCIAL：社交账号链接区 ===== -->
  <section id="social" style="position:relative; padding:clamp(80px,11vw,150px) clamp(20px,5vw,64px); background:linear-gradient(180deg,#eaf6fe,#fdf6ea);">
    <div style="max-width:1100px; margin:0 auto;">
      <div data-reveal="" style="text-align:center;">
        <div style="font-family:'Fredoka',sans-serif; font-size:13px; font-weight:600; letter-spacing:4px; color:var(--coral);">FIND ME · 社交</div>
        <h2 style="margin:14px 0 0; font-family:'ZCOOL KuaiLe',cursive; font-size:clamp(34px,5vw,58px); color:var(--ink);">来找雨枫玩呀</h2>
        <p style="margin:14px auto 0; max-width:440px; font-size:14px; color:var(--ink-soft);">把链接换成你自己的主页就好啦 · replace with your own links</p>
      </div>
      <!-- 社交卡片网格：repeat(auto-fit,minmax(200px,1fr)) 表示每张卡片最小200px，自动根据屏幕宽度决定一行放几张 -->
      <div data-reveal="" style="margin-top:50px; display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:18px;">
        {socials.map((social) => social.isQr ? (
          <div data-card="" data-qr-src={social.url} data-qr-name={social.name} style="display:flex; align-items:center; gap:16px; padding:22px 24px; border-radius:20px; position:relative; background:#fff; box-shadow:0 12px 28px rgba(76,130,170,.12); transition:transform .25s ease, box-shadow .25s ease; cursor:pointer;" style-hover="transform:translateY(-6px); box-shadow:0 22px 44px rgba(76,130,170,.22);">
            <span style={`flex:none; width:48px; height:48px; border-radius:14px; background:${social.color}; display:flex; align-items:center; justify-content:center; overflow:hidden; box-shadow:inset 0 0 0 1px rgba(0,0,0,.04);`}>
              {social.iconSrc && <img src={social.iconSrc} alt={social.name} style="width:62%; height:62%; object-fit:contain; display:block;">}
              {social.iconText && <span style={`font-family:'ZCOOL KuaiLe',cursive; font-size:26px; line-height:1; color:${social.iconColor};`}>{social.iconText}</span>}
            </span>
            <span style="min-width:0;">
              <span style="display:block; font-weight:700; font-size:15px; color:var(--ink);">{social.name}</span>
              <span style="display:block; font-family:'Fredoka','Noto Sans SC',sans-serif; font-size:12px; color:var(--ink-soft); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{social.handle}</span>
            </span>
            <span style="margin-left:auto; color:var(--sky-deep); font-size:18px;">→</span>
          </div>
        ) : (
          <a data-card="" href={social.url} target="_blank" rel="noopener" style="display:flex; align-items:center; gap:16px; padding:22px 24px; border-radius:20px; position:relative; background:#fff; box-shadow:0 12px 28px rgba(76,130,170,.12); transition:transform .25s ease, box-shadow .25s ease;" style-hover="transform:translateY(-6px); box-shadow:0 22px 44px rgba(76,130,170,.22);">
            <span style={`flex:none; width:48px; height:48px; border-radius:14px; background:${social.color}; display:flex; align-items:center; justify-content:center; overflow:hidden; box-shadow:inset 0 0 0 1px rgba(0,0,0,.04);`}>
              {social.iconSrc && <img src={social.iconSrc} alt={social.name} style="width:62%; height:62%; object-fit:contain; display:block;">}
              {social.iconText && <span style={`font-family:'ZCOOL KuaiLe',cursive; font-size:26px; line-height:1; color:${social.iconColor};`}>{social.iconText}</span>}
            </span>
            <span style="min-width:0;">
              <span style="display:block; font-weight:700; font-size:15px; color:var(--ink);">{social.name}</span>
              <span style="display:block; font-family:'Fredoka','Noto Sans SC',sans-serif; font-size:12px; color:var(--ink-soft); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{social.handle}</span>
            </span>
            <span style="margin-left:auto; color:var(--sky-deep); font-size:18px;">→</span>
            {social.tag && (
              <span style="position:absolute; top:-11px; right:-7px; transform:rotate(8deg); padding:4px 11px; border-radius:999px; background:var(--cream); color:#7a5a1d; font-family:'ZCOOL KuaiLe',cursive; font-size:12px; box-shadow:0 5px 12px rgba(245,217,138,.55);">{social.tag}</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CONTACT：留言表单区 ===== -->
  <section id="contact" style="position:relative; padding:clamp(80px,11vw,150px) clamp(20px,5vw,64px); background:#fff;">
    <div style="max-width:680px; margin:0 auto; text-align:center;">
      <div data-reveal="" style="font-family:'Fredoka',sans-serif; font-size:13px; font-weight:600; letter-spacing:4px; color:var(--coral);">MESSAGE · 留言</div>
      <h2 data-reveal="" style="margin:14px 0 0; font-family:'ZCOOL KuaiLe',cursive; font-size:clamp(34px,5vw,58px); color:var(--ink);">丢句话给我吧 ✍</h2>
      <p data-reveal="" style="margin:14px 0 0; font-size:14px; color:var(--ink-soft);">悄悄话、夸夸、或者只是打个招呼都可以～</p>
      <form id="rp-message-form" data-reveal="" style="margin-top:40px; text-align:left; padding:clamp(24px,4vw,40px); border-radius:28px; background:linear-gradient(180deg,#f7fcff,#eef7fe); border:1px solid #e1f0fb; box-shadow:0 24px 50px rgba(76,130,170,.14);">
        <!-- <label> 字段说明文字“你的名字” -->
        <label style="display:block; font-size:13px; font-weight:600; color:var(--ink-soft); margin-bottom:8px;">你的名字 · name</label>
        <!-- <input type="text"> 单行文本输入框；style-focus 是自定义运行时识别的“输入框被点击聚焦时”的样式（边框变蓝） -->
        <input type="text" placeholder="怎么称呼你呢？" style="width:100%; padding:14px 18px; border-radius:14px; border:1.5px solid #dcebf8; background:#fff; font-size:15px; color:var(--ink); outline:none; transition:border-color .2s;" style-focus="border-color:var(--sky-deep);">
        <label style="display:block; font-size:13px; font-weight:600; color:var(--ink-soft); margin:20px 0 8px;">留言 · message</label>
        <!-- <textarea> 多行文本框，rows="4" 表示默认显示4行高度，resize:vertical 允许用户手动拖拽调整高度（只能上下拖，不能左右拖） -->
        <textarea rows="4" placeholder="想对雨枫说的话…" style="width:100%; padding:14px 18px; border-radius:14px; border:1.5px solid #dcebf8; background:#fff; font-size:15px; color:var(--ink); outline:none; resize:vertical; transition:border-color .2s;" style-focus="border-color:var(--sky-deep);"></textarea>
        <!-- <button type="submit"> 提交按钮：点击会触发上面 <form> 的 onsubmit -->
        <button type="submit" style="margin-top:22px; width:100%; padding:16px; border:none; border-radius:14px; background:var(--accent); color:#fff; font-size:16px; font-weight:700; cursor:pointer; box-shadow:0 12px 26px rgba(243,128,90,.4); transition:transform .2s, box-shadow .2s;" style-hover="transform:translateY(-3px); box-shadow:0 18px 34px rgba(243,128,90,.5);">送出 ✦ send</button>
        <div id="rp-message-sent" hidden style="margin-top:18px; text-align:center; font-family:'ZCOOL KuaiLe',cursive; font-size:16px; color:var(--coral);">收到啦，谢谢你～ ♥</div>
      </form>
    </div>
  </section>

  <!-- ===== FOOTER：页脚区 ===== -->
  <!-- <footer> 深色背景的页脚，overflow:hidden 用来裁掉超出范围的大字背景装饰 -->
  <footer style="position:relative; padding:clamp(50px,7vw,80px) clamp(20px,5vw,64px) 44px; background:var(--ink); color:#cfe0ee; overflow:hidden;">
    <!-- 右上角巨大的半透明“雨枫”二字，纯背景装饰，不影响阅读 -->
    <div style="position:absolute; top:-40px; right:6%; font-family:'ZCOOL KuaiLe',cursive; font-size:120px; color:rgba(169,217,245,.08); pointer-events:none;">雨枫</div>
    <!-- 页脚主体：左边品牌信息，右边导航链接列表，两端对齐 -->
    <div style="position:relative; max-width:1180px; margin:0 auto; display:flex; flex-wrap:wrap; gap:24px; align-items:center; justify-content:space-between;">
      <div>
        <div style="display:flex; align-items:baseline; gap:10px;">
          <span style="font-family:'ZCOOL KuaiLe',cursive; font-size:28px; color:#fff;">雨枫</span>
          <span style="font-family:'Fredoka',sans-serif; font-weight:600; letter-spacing:2px; color:var(--sky);">rainple</span>
        </div>
        <p style="margin:10px 0 0; font-size:13px; color:#9fb6c9; max-width:360px; line-height:1.7;">一只住在云与温泉之间的小狼龙 · a little wolfdragon between clouds &amp; warm springs.</p>
      </div>
      <!-- 竖排导航链接列表（重复一遍顶部导航的锚点链接，方便用户在页面底部也能快速跳转） -->
      <div style="display:flex; flex-direction:column; gap:8px; font-size:13px;">
        <a href="#about" style="color:#cfe0ee;" style-hover="color:#fff;">关于</a>
        <a href="#design" style="color:#cfe0ee;" style-hover="color:#fff;">设定</a>
        <a href="#gallery" style="color:#cfe0ee;" style-hover="color:#fff;">画作</a>
        <a href="#fursuit" style="color:#cfe0ee;" style-hover="color:#fff;">毛照</a>
        <a href="#social" style="color:#cfe0ee;" style-hover="color:#fff;">社交</a>
      </div>
    </div>
    <!-- 最底部版权行：年份由 Astro 在构建时自动计算。 -->
    <div style="position:relative; max-width:1180px; margin:34px auto 0; padding-top:22px; border-top:1px solid rgba(255,255,255,.1); display:flex; flex-wrap:wrap; gap:12px; justify-content:space-between; font-size:12px; color:#8ba2b5;">
      <span>© {year} 雨枫 rainple · all art belongs to its creator</span>
      <span style="font-family:'Fredoka',sans-serif;">made with ♥ &amp; a little lightning</span>
    </div>
  </footer>

  <!-- ===== LIGHTBOX：点击图片后弹出的全屏大图弹窗 ===== -->
    <div id="rp-lightbox" hidden style="position:fixed; inset:0; z-index:200; display:flex; align-items:center; justify-content:center; padding:5vh 4vw; background:rgba(28,46,64,.82); backdrop-filter:blur(8px); cursor:zoom-out; animation:twinkleP .01s;">
      <!-- 弹窗内容容器：放大图和说明文字 -->
      <div style="position:relative; max-width:90vw; max-height:90vh; display:flex; flex-direction:column; align-items:center;">
        <!-- 大图本身：src 默认是一张1x1的透明占位图(base64编码的gif)，真正的图片地址由底部脚本在打开弹窗时通过 JS 动态设置(im.src=...) -->
        <img id="rp-lightbox-img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" style="max-width:90vw; max-height:80vh; object-fit:contain; border-radius:18px; box-shadow:0 30px 80px rgba(0,0,0,.5); border:5px solid rgba(255,255,255,.9);">
        <!-- 大图下方的标题/英文小字说明 -->
        <div style="margin-top:16px; text-align:center; color:#fff;">
          <div id="rp-lightbox-cap" style="font-family:'ZCOOL KuaiLe',cursive; font-size:20px;"></div>
          <div id="rp-lightbox-en" style="font-family:'Fredoka',sans-serif; font-size:12px; letter-spacing:1px; opacity:.8;"></div>
        </div>
      </div>
      <!-- 右上角圆形关闭按钮“✕”，position:fixed 让它始终固定在屏幕角落而不是跟着内容滚动 -->
      <button data-dialog-close style="position:fixed; top:24px; right:28px; width:46px; height:46px; border:none; border-radius:50%; background:rgba(255,255,255,.9); color:var(--ink); font-size:22px; cursor:pointer; box-shadow:0 8px 20px rgba(0,0,0,.3);">✕</button>
    </div>

  <!-- ===== QR 小窗：点击 QQ/微信等二维码卡片时弹出的居中弹窗 ===== -->
    <div id="rp-qr-dialog" hidden style="position:fixed; inset:0; z-index:210; display:flex; align-items:center; justify-content:center; padding:5vh 5vw; background:rgba(28,46,64,.82); backdrop-filter:blur(8px); cursor:pointer;">
      <div data-dialog-panel style="position:relative; max-width:min(86vw,340px); background:#fff; border-radius:20px; padding:20px 20px 16px; box-shadow:0 30px 80px rgba(0,0,0,.5); cursor:default;">
        <button data-dialog-close style="position:absolute; top:-14px; right:-14px; width:36px; height:36px; border:none; border-radius:50%; background:rgba(255,255,255,.95); color:var(--ink); font-size:18px; cursor:pointer; box-shadow:0 6px 18px rgba(0,0,0,.3); display:flex; align-items:center; justify-content:center;">✕</button>
        <img id="rp-qr-img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" style="display:block; width:100%; max-height:70vh; object-fit:contain; border-radius:12px;">
        <div id="rp-qr-name" style="margin-top:12px; text-align:center; font-size:14px; color:var(--ink);"></div>
      </div>
    </div>

<!-- 最外层 div#rainple-root 结束 -->
</div>
</div></div>

<script>
  import "../../scripts/oc-home";
</script>

<!-- 图片保护：禁右键、禁拖拽、透明遮罩（水印由 scripts/watermark.js 在构建时添加） -->
<style is:global>
  img, video {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
  }
  /* 画廊卡片与灯箱大图：图片本身不响应鼠标，右键/拖拽落在容器上 */
  figure[data-card-fig] img,
  #rp-lightbox-img {
    pointer-events: none;
  }
  /* 卡片再盖一层透明遮罩 */
  figure[data-card-fig]::after {
    content: "";
    position: absolute;
    inset: 0;
  }
