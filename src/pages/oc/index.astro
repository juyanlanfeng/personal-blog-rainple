  <!-- ===== ABOUT：关于介绍区块 ===== -->
  <!-- <section id="about"> 整块区域，纯白背景，上下留白用 clamp() 随屏幕自适应 -->
  <section id="about" style="position:relative; padding:clamp(80px,11vw,150px) clamp(20px,5vw,64px); background:#fff;">
    <!-- 内容容器：grid 分左右两列（左1.1份文字 : 右0.9份卡片），限宽居中 -->
    <div style="max-width:1180px; margin:0 auto; display:grid; grid-template-columns:1.1fr .9fr; gap:clamp(30px,5vw,80px); align-items:center;">
      <!-- 左列：纯文字介绍 -->
      <div>
        <!-- 小号橙色分类标签文字“ABOUT·关于” -->
        <div data-reveal="" style="font-family:'Fredoka',sans-serif; font-size:13px; font-weight:600; letter-spacing:4px; color:var(--coral);">ABOUT · 关于</div>
        <!-- <h2> 二级标题“先自我介绍一下！” -->
        <h2 data-reveal="" style="margin:14px 0 0; font-family:'ZCOOL KuaiLe',cursive; font-size:clamp(34px,5vw,58px); color:var(--ink); line-height:1.15;">先自我介绍一下！</h2>
        <!-- 中文介绍段落，行高 line-height:2 拉大方便阅读 -->
        <p data-reveal="" style="margin:26px 0 0; font-size:clamp(15px,1.4vw,17px); line-height:2; color:var(--ink-soft);">雨枫是一只温柔又有点小馋的小狼龙。喜欢在雾气腾腾的温泉里发呆，秋天会捧着热乎的烤红薯，冬夜把自己埋进雪和暖汤里。多条蓬松的尾巴是她的骄傲，而生气或开心时，耳朵上的闪电纹会轻轻亮起来。</p>
        <!-- 英文版介绍段落，字号更小一些作为补充说明 -->
        <p data-reveal="" style="margin:18px 0 0; font-family:'Fredoka',sans-serif; font-size:14px; line-height:1.95; color:var(--ink-soft);">rainple is a gentle, slightly greedy little wolfdragon. She loves daydreaming in steamy hot springs, holding a warm roasted sweet potato in autumn, and curling into snow and warm water on winter nights. Her fluffy tails are her pride — and when she's happy, the lightning marks on her ears softly glow.</p>
      </div>
      <!-- 右列：仿“个人资料卡”的卡片 -->
      <div data-reveal="" style="position:relative;">
        <!-- 卡片右上角的圆形虚化光斑装饰，纯背景修饰用 -->
        <div style="position:absolute; inset:-14px -14px auto auto; width:120px; height:120px; border-radius:50%; background:radial-gradient(circle,var(--sky2),transparent 70%); z-index:0;"></div>
        <!-- 卡片主体：圆角矩形，浅蓝渐变背景，柔和阴影 -->
        <div style="position:relative; z-index:1; border-radius:28px; background:linear-gradient(180deg,#f7fcff,#eef7fe); border:1px solid #e1f0fb; box-shadow:0 24px 50px rgba(76,130,170,.16); overflow:hidden;">
          <!-- 卡片顶部“标题栏”，模仿电脑窗口的三个圆点按钮（红/黄/蓝），右边写着卡片名 PROFILE.CARD -->
          <div style="padding:22px 26px; border-bottom:1px dashed #d4e8f7; display:flex; align-items:center; gap:10px;">
            <span style="width:11px; height:11px; border-radius:50%; background:var(--coral);"></span>
            <span style="width:11px; height:11px; border-radius:50%; background:var(--cream);"></span>
            <span style="width:11px; height:11px; border-radius:50%; background:var(--sky);"></span>
            <span style="margin-left:auto; font-family:'Fredoka',sans-serif; font-size:12px; letter-spacing:2px; color:var(--ink-soft);">PROFILE.CARD</span>
          </div>
          <!-- 卡片正文：资料列表区域 -->
          <div style="padding:8px 26px 26px;">
            <!-- Astro 在构建时根据资料数据生成每一行。 -->
            {facts.map((fact) => (
              <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; padding:15px 0; border-bottom:1px solid #ecf5fc;">
                <span style="font-size:13px; color:var(--ink-soft); letter-spacing:1px;">{fact.k}</span>
                <span style="font-size:15px; font-weight:600; color:var(--ink); text-align:right;">{fact.v}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== DESIGN / REFERENCE：角色设定区（配色卡 + 特征 + 性格） ===== -->
  <section id="design" style="position:relative; padding:clamp(80px,11vw,150px) clamp(20px,5vw,64px); background:linear-gradient(180deg,#f3fafe,#eaf6fe);">
    <div style="max-width:1180px; margin:0 auto;">
      <!-- 区块标题：居中的小标签 + 大标题 -->
