      <span style="position:relative; width:24px; height:38px; border:2px solid var(--sky-deep); border-radius:14px; display:block;"><span style="position:absolute; top:7px; left:50%; transform:translateX(-50%); width:5px; height:5px; border-radius:50%; background:var(--sky-deep); animation:scrollDot 1.6s ease-in-out infinite;"></span></span>
