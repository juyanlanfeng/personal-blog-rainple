      <i class="rp-rain rp-rain--light" style="--x:39%; --delay:-6.9s; --dur:8.8s; --len:58px;"></i>
      <i class="rp-rain" style="--x:46%; --delay:-1.9s; --dur:7.4s; --len:72px;"></i>
