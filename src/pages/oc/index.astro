---
import { facts, features, palette, socials, traits } from "../../data/oc-home";
import { getCategory } from "../../utils/oc-gallery";

const art = getCategory("art");
const fursuit = getCategory("fursuit");

function mainData(category: ReturnType<typeof getCategory>) {
	const featured = category.featured.filter((item) => item.type === "image");
	const featuredSources = new Set(featured.map((item) => item.src));
	const more = category.all.filter((item) => !featuredSources.has(item.src));
	return { featured, more };
}

const gallery = mainData(art);
const furPhotos = mainData(fursuit);
const galleryTotalLabel = `查看全部 ${gallery.featured.length + gallery.more.length} 项 →`;
const furTotalLabel = `查看全部 ${furPhotos.featured.length + furPhotos.more.length} 项 →`;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="zh-CN"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

  <style is:global>
    /* 本地字体声明：Fredoka(英文标题)与 ZCOOL KuaiLe(中文毛笔标题)存放在 public/oc/fonts/，随站点一起部署，无需联网加载 */
    @font-face{ font-family:'Fredoka'; font-style:normal; font-weight:400; font-display:swap; src:url(/oc/fonts/fredoka-400.woff2) format('woff2'); }
    @font-face{ font-family:'Fredoka'; font-style:normal; font-weight:500; font-display:swap; src:url(/oc/fonts/fredoka-500.woff2) format('woff2'); }
    @font-face{ font-family:'Fredoka'; font-style:normal; font-weight:600; font-display:swap; src:url(/oc/fonts/fredoka-600.woff2) format('woff2'); }
    @font-face{ font-family:'Fredoka'; font-style:normal; font-weight:700; font-display:swap; src:url(/oc/fonts/fredoka-700.woff2) format('woff2'); }
    @font-face{ font-family:'ZCOOL KuaiLe'; font-style:normal; font-weight:400; font-display:swap; src:url(/oc/fonts/zcool-kuaila-400.woff2) format('woff2'); }
    /* * 是“所有元素”的意思：让每个元素的 padding/border 都算在宽高内，方便布局计算 */
    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    #dc-root,#dc-root>.sc-host{ height:100%; }
    #rp-lightbox[hidden],#rp-qr-dialog[hidden],#rp-message-sent[hidden]{ display:none !important; }
    /* <html> 整个文档：点击锚点(#xxx)跳转时平滑滚动，而不是瞬间跳转 */
    html{ scroll-behavior:smooth; }
    /* <body> 整个页面主体：去掉默认外边距；统一字体为思源黑体；文字颜色深蓝灰；背景浅蓝白；隐藏横向滚动条；字体抗锯齿更清晰 */
    body{ margin:0; font-family:system-ui,-apple-system,"PingFang SC","Microsoft YaHei","Hiragino Sans GB",sans-serif; color:#33485c; background:#f3fafe; overflow-x:hidden; -webkit-font-smoothing:antialiased; }
    /* 所有 <img> 图片：默认按块级显示，宽度不超过父容器（防止图片溢出撑破布局） */
    img{ display:block; max-width:100%; }
    /* 所有 <a> 链接：文字颜色继承父元素（不用浏览器默认蓝色），并去掉默认下划线 */
    a{ color:inherit; text-decoration:none; }
    /* 输入框/文本域/按钮：统一使用页面字体，而不是浏览器默认字体 */
    input,textarea,button{ font-family:inherit; }
    /* 鼠标选中文字时的高亮颜色：背景珊瑚色、文字深蓝灰 */
    ::selection{ background:#f8c5ac; color:#33485c; }
    /* 滚动条整体宽度（仅 Chrome/Edge 等 WebKit 内核浏览器生效） */
    ::-webkit-scrollbar{ width:11px; }
    /* 滚动条滑块的颜色、圆角、与轨道间的留白边框 */
    ::-webkit-scrollbar-thumb{ background:#bfe0f5; border-radius:9px; border:3px solid #f3fafe; }
    /* 以下一大段 @keyframes 都是“动画剧本”：定义一个动画从开始到结束怎么变化，
       具体哪个元素会用上某个动画，要看后面 style="animation:xxx" 里引用的名字 */
    /* riseP：从下往上飘起并轻微右移（气泡粒子用） */
    @keyframes riseP{ 0%{ transform:translateY(8vh) translateX(0); } 100%{ transform:translateY(-110vh) translateX(28px); } }
    /* fallP：从上往下飘落并旋转（雪花粒子用） */
    @keyframes fallP{ 0%{ transform:translateY(-12vh) translateX(0) rotate(0deg); } 100%{ transform:translateY(112vh) translateX(34px) rotate(220deg); } }
    /* twinkleP：忽明忽暗、忽大忽小的闪烁效果（星屑粒子用） */
    @keyframes twinkleP{ 0%,100%{ opacity:.12; transform:scale(.7);} 50%{ opacity:.95; transform:scale(1.15);} }
    /* bob：上下轻轻浮动并小幅摇摆（首屏配图用） */
    @keyframes bob{ 0%,100%{ transform:translateY(0) rotate(-1deg);} 50%{ transform:translateY(-16px) rotate(1deg);} }
    /* blobDrift：缓慢漂移并缩放（背景大圆形光斑用） */
    @keyframes blobDrift{ 0%,100%{ transform:translate(0,0) scale(1);} 33%{ transform:translate(36px,-26px) scale(1.08);} 66%{ transform:translate(-26px,22px) scale(.94);} }
    /* scrollDot：上下移动并淡入淡出（首屏“向下滚动”提示用） */
    @keyframes scrollDot{ 0%{ transform:translateY(0); opacity:0;} 30%{ opacity:1;} 100%{ transform:translateY(20px); opacity:0;} }
    /* floatBadge：上下浮动并左右轻微倾斜（目前未在下方元素中引用，是备用动画） */
    @keyframes floatBadge{ 0%,100%{ transform:translateY(0) rotate(-6deg);} 50%{ transform:translateY(-10px) rotate(4deg);} }
    /* spinSlow：匀速 360 度旋转（圆形徽章用） */
    @keyframes spinSlow{ from{ transform:rotate(0);} to{ transform:rotate(360deg);} }
    /* wobble：左右摇晃并上下浮动（首屏漂浮文字气泡用） */
    @keyframes wobble{ 0%,100%{ transform:rotate(-3deg) translateY(0);} 50%{ transform:rotate(3deg) translateY(-7px);} }
    /* marquee：向左匀速平移（跑马灯文字横向滚动用） */
    @keyframes marquee{ from{ transform:translateX(0);} to{ transform:translateX(-50%);} }
    /* pawFade：从原位置淡出并向上飘走缩小（鼠标移动时的爱心/星星拖尾特效用） */
    @keyframes pawFade{ 0%{ opacity:.95; transform:translate(-50%,-50%) scale(1);} 100%{ opacity:0; transform:translate(-50%,-140%) scale(.35);} }
    /* 以下几条专门针对 #gallery（画作区）和 #fursuit（毛照区）里的 <figure> 照片卡片 */
    /* 给每张照片卡片统一设置变化时的过渡动画（旋转/阴影/透明度/模糊都要慢慢过渡，而不是瞬间跳变） */
    #gallery figure, #fursuit figure{ transition:transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s ease, opacity .85s cubic-bezier(.16,1,.3,1), filter .85s cubic-bezier(.16,1,.3,1) !important; }
    /* 第1、5、9...张照片：固定逆时针旋转 2.3 度，营造“随手贴上去”的错落感 */
    #gallery figure:nth-of-type(4n+1), #fursuit figure:nth-of-type(4n+1){ transform:rotate(-2.3deg); }
    /* 第2、6、10...张照片：固定顺时针旋转 1.9 度 */
    #gallery figure:nth-of-type(4n+2), #fursuit figure:nth-of-type(4n+2){ transform:rotate(1.9deg); }
    /* 第3、7、11...张照片：固定逆时针旋转 1.1 度 */
    #gallery figure:nth-of-type(4n+3), #fursuit figure:nth-of-type(4n+3){ transform:rotate(-1.1deg); }
    /* 第4、8、12...张照片：固定顺时针旋转 2.5 度 */
    #gallery figure:nth-of-type(4n),   #fursuit figure:nth-of-type(4n){ transform:rotate(2.5deg); }
    /* 鼠标悬停在任意一张照片上时：摆正角度、向上抬起并放大一点，同时阴影变深，层级提到最上面 */
    #gallery figure:hover, #fursuit figure:hover{ transform:rotate(0) translateY(-7px) scale(1.025) !important; z-index:5; box-shadow:0 24px 50px rgba(170, 125, 76, 0.28) !important; }
    /* 用 ::before 在每张照片顶部“画”出一条像纸质相册里的胶带贴纸（黄色半透明矩形+轻微旋转） */
    #gallery figure::before, #fursuit figure::before{ content:''; position:absolute; top:9px; left:50%; width:78px; height:22px; transform:translateX(-50%) rotate(-4deg); background:rgba(245,217,138,.5); box-shadow:0 2px 6px rgba(0,0,0,.08); z-index:4; pointer-events:none; }
    /* 偶数序号照片的胶带：换成蓝色、反方向旋转，让胶带颜色和方向交替出现 */
    #gallery figure:nth-of-type(even)::before, #fursuit figure:nth-of-type(even)::before{ transform:translateX(-50%) rotate(5deg); background:rgba(169,217,245,.5); }
  /* .rp-more-btn 是“查看更多”按钮：设置变化时的过渡动画（位移/阴影/边框色/文字色） */
  .rp-more-btn{ transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease, color .2s ease; }
/* 鼠标悬停“查看更多”按钮时：向上抬起、阴影加深、边框和文字变成主题强调色 */
.rp-more-btn:hover{ transform:translateY(-2px); box-shadow:0 12px 28px rgba(76,130,170,.22); border-color:var(--accent); color:var(--accent); }
/* Hero atmosphere: several wide, low-contrast shapes make the empty sky feel layered without competing with the character art. */
#top{ isolation:isolate; overflow:hidden; }
.rp-sky-ribbon{ position:absolute; z-index:0; pointer-events:none; border-radius:999px; filter:blur(2px); opacity:.72; }
.rp-sky-ribbon--one{ top:17%; left:-6%; width:38vw; height:10vw; min-height:90px; background:linear-gradient(90deg,transparent,rgba(255,255,255,.48),transparent); transform:rotate(-7deg); }
.rp-sky-ribbon--two{ right:18%; bottom:17%; width:34vw; height:8vw; min-height:72px; background:linear-gradient(90deg,transparent,rgba(255,245,220,.42),transparent); transform:rotate(8deg); }
.rp-weather-layer{ position:absolute; inset:0; z-index:2; overflow:hidden; pointer-events:none; }
.rp-rain{ --x:50%; --delay:0s; --dur:8s; --len:50px; position:absolute; top:-20%; left:var(--x); width:2.5px; height:var(--len); border-radius:999px; opacity:0; background:linear-gradient(180deg,transparent,rgba(111,184,232,.24) 18%,rgba(85,169,222,.82)); box-shadow:0 8px 14px rgba(79,159,211,.16); animation:gentleRain var(--dur) linear var(--delay) infinite; }
.rp-rain::after{ content:''; position:absolute; left:50%; bottom:-5px; width:5px; height:8px; border-radius:60% 60% 65% 65%; background:rgba(111,184,232,.66); transform:translateX(-50%); box-shadow:0 3px 7px rgba(79,159,211,.2); }
@keyframes gentleRain{ 0%{ transform:translate3d(36px,-18vh,0) rotate(8deg); opacity:0; } 9%{ opacity:.88; } 80%{ opacity:.68; } 100%{ transform:translate3d(-48px,122vh,0) rotate(8deg); opacity:0; } }
/* 枫叶 (rp-maple) — 加拿大国旗款 11 尖枫叶 SVG，四种秋叶配色在 public/oc/maple-*.svg 里。
   变体：autumn(秋橘 #f3805a) / russet(朱红 #d4634a) / persimmon(暖杏 #e8a854) / umber(赭石 #b86f4a) */
.rp-maple{ --x:50%; --y:35%; --size:36px; --turn:0deg; --delay:0s; --dur:12s; position:absolute; left:var(--x); top:-24%; width:calc(var(--size) * 1.12); height:var(--size); opacity:.84; filter:drop-shadow(0 5px 5px rgba(104,68,45,.18)); animation:mapleFall var(--dur) linear var(--delay) infinite; }
.rp-maple::before{ content:''; display:block; width:100%; height:100%; background:url(/oc/maple-autumn.svg) center/contain no-repeat; }
/* 四种配色变体，各指向对应颜色的 SVG 文件；opacity 控制 CSS 透明度，svg 本身颜色已写死在文件里 */
.rp-maple--autumn::before{ background-image:url(/oc/maple-autumn.svg); }
.rp-maple--russet::before{ background-image:url(/oc/maple-russet.svg); }
.rp-maple--persimmon::before{ background-image:url(/oc/maple-persimmon.svg); }
.rp-maple--umber::before{ background-image:url(/oc/maple-umber.svg); }
/* 不同变体的整体透明度区分远近层次 */
.rp-maple--autumn{ opacity:.86; }
.rp-maple--russet{ opacity:.78; }
.rp-maple--persimmon{ opacity:.72; }
.rp-maple--umber{ opacity:.66; }
@keyframes mapleFall{ 0%{ transform:translate3d(12px,-16vh,0) rotate(var(--turn)); opacity:0; } 8%{ opacity:.84; } 32%{ transform:translate3d(34px,34vh,0) rotate(calc(var(--turn) + 145deg)); } 62%{ transform:translate3d(-24px,72vh,0) rotate(calc(var(--turn) + 295deg)); } 88%{ opacity:.74; } 100%{ transform:translate3d(20px,130vh,0) rotate(calc(var(--turn) + 510deg)); opacity:0; } }
.rp-drop-charm{ --x:50%; --y:50%; --size:15px; --delay:0s; position:absolute; left:var(--x); top:var(--y); width:var(--size); height:var(--size); border-radius:52% 48% 54% 46% / 68% 68% 32% 32%; background:linear-gradient(145deg,rgba(255,255,255,.82),rgba(134,205,245,.28)); border:1px solid rgba(111,184,232,.42); box-shadow:inset 3px 3px 4px rgba(255,255,255,.65),0 5px 12px rgba(111,184,232,.12); animation:dropBob 5.6s ease-in-out var(--delay) infinite; }
.rp-drop-charm::after{ content:''; position:absolute; top:18%; left:27%; width:26%; height:26%; border-radius:50%; background:rgba(255,255,255,.88); }
@keyframes dropBob{ 0%,100%{ transform:translateY(0) rotate(8deg); } 50%{ transform:translateY(-10px) rotate(-5deg); } }
.rp-ripple{ position:absolute; width:clamp(80px,9vw,150px); height:clamp(20px,2.4vw,38px); border:1px solid rgba(111,184,232,.3); border-radius:50%; opacity:0; animation:waterRipple 5.8s ease-out infinite; }
.rp-ripple::after{ content:''; position:absolute; inset:20%; border:1px solid rgba(111,184,232,.28); border-radius:inherit; }
.rp-ripple--one{ left:9%; bottom:10%; animation-delay:-1.4s; }
.rp-ripple--two{ right:8%; bottom:18%; animation-delay:-4.1s; }
@keyframes waterRipple{ 0%{ transform:scale(.46); opacity:0; } 20%{ opacity:.52; } 78%,100%{ transform:scale(1.28); opacity:0; } }
.rp-hero-orbit{ position:absolute; inset:-30px -34px; z-index:0; border:1px dashed rgba(111,184,232,.38); border-radius:42% 58% 48% 52%; animation:orbitTurn 34s linear infinite; }
.rp-hero-orbit::before,.rp-hero-orbit::after{ content:''; position:absolute; width:10px; height:10px; border-radius:50%; box-shadow:0 0 0 7px rgba(255,255,255,.44); }
.rp-hero-orbit::before{ top:18%; left:2%; background:var(--cream); }
.rp-hero-orbit::after{ right:8%; bottom:8%; background:var(--sky-deep); }
@keyframes orbitTurn{ to{ transform:rotate(360deg); } }
.rp-horizon{ position:absolute; left:0; right:0; bottom:-1px; height:150px; z-index:1; pointer-events:none; background:linear-gradient(180deg,rgba(255,247,232,0),rgba(255,247,232,.46) 58%,var(--hero-bottom) 100%); }
.rp-horizon::after{ content:''; position:absolute; left:0; right:0; bottom:0; height:64px; background:linear-gradient(180deg,transparent,rgba(255,244,225,.34)); }
.rp-marquee-zone{ position:relative; isolation:isolate; overflow:hidden; margin:-2px 0 0; padding:36px 0 44px; background:linear-gradient(180deg,var(--hero-bottom) 0%,#fff6e9 48%,var(--accent-wash) 100%); }
.rp-marquee-zone::before{ content:'SOFT RAIN  /  MAPLE BREEZE  /  WARM CLOUD'; position:absolute; top:13px; left:clamp(22px,6vw,88px); font-family:'Fredoka',sans-serif; font-size:10px; font-weight:600; letter-spacing:3px; color:rgba(98,120,139,.52); }
.rp-marquee-zone::after{ content:'\2726  \00B7  \2727'; position:absolute; right:clamp(24px,7vw,110px); top:8px; font-size:20px; letter-spacing:10px; color:rgba(243,128,90,.48); transform:rotate(7deg); }
.rp-transition-leaf{ position:absolute; z-index:0; width:22px; height:22px; background:#f59c7e; opacity:.34; clip-path:polygon(50% 0,59% 24%,76% 13%,72% 37%,95% 34%,79% 52%,92% 64%,65% 64%,68% 91%,53% 73%,50% 100%,47% 73%,31% 91%,35% 64%,8% 64%,22% 52%,5% 34%,29% 37%,24% 13%,42% 24%); }
.rp-transition-leaf--one{ top:6px; right:17%; transform:rotate(18deg); }
.rp-transition-leaf--two{ bottom:7px; left:12%; width:17px; height:17px; background:#e5bd59; transform:rotate(-24deg); }
.rp-marquee-strip{ overflow:hidden; background:linear-gradient(90deg,#f27858 0%,var(--accent) 48%,#f58e67 100%); transform:rotate(-1.15deg) scale(1.025); padding:14px 0; border-top:1px solid rgba(255,255,255,.55); border-bottom:1px solid rgba(209,91,56,.12); box-shadow:0 16px 34px rgba(218,112,76,.22),0 -10px 30px rgba(255,214,190,.2); }
@media (max-width:720px){
  .rp-sky-ribbon--one{ width:65vw; }
  .rp-sky-ribbon--two{ width:58vw; right:-8%; bottom:21%; }
  .rp-hero-orbit{ inset:-18px; }
  .rp-horizon{ height:110px; }
  .rp-marquee-zone{ padding:30px 0 34px; }
  .rp-marquee-zone::before{ letter-spacing:2px; font-size:8px; }
  .rp-rain--light,.rp-ripple--two{ display:none; }
  .rp-maple{ opacity:.68; --size:30px; }
}
@media (prefers-reduced-motion:reduce){ .rp-hero-orbit,.rp-rain,.rp-maple,.rp-drop-charm,.rp-ripple{ animation:none; } .rp-rain{ display:none; } .rp-maple{ top:var(--y); } }
</style>
</head>
<body>
<div id="dc-root"><div class="sc-host" data-sc-name="Root">

<!-- 整个页面的最外层容器 div，id="rainple-root"；style 里一长串 --xxx 是“CSS变量”，
     相当于先定义好一批可复用的颜色（天蓝/奶黄/珊瑚色等），后面元素用 var(--xxx) 来引用，
     这样换主题时只改这里几个变量，全站颜色跟着变。position/width/overflow/color 是给这个容器本身设置定位、宽度、裁切溢出内容、默认文字颜色 -->
<div id="rainple-root" data-screen-label="雨枫 rainple 主页" style="--sky:#a9d9f5; --sky2:#cdeafb; --sky-deep:#6fb8e8; --cream:#f5d98a; --cream2:#fbe6bd; --coral:#f3805a; --ink:#33485c; --ink-soft:#62788b; --paper:#f3fafe; --accent:#00b3ff; --hero-bottom:#fff4e1; --accent-wash:#ffe2d3; --hero-grad:radial-gradient(ellipse at 84% 12%,rgba(255,255,255,.86),transparent 31%),radial-gradient(ellipse at 10% 76%,rgba(255,224,157,.26),transparent 31%),linear-gradient(180deg,#c9e9fb 0%,#e5f4fc 48%,#f5f7f1 76%,#fff4e1 100%); position:relative; width:100%; overflow:hidden; color:var(--ink);">

  <!-- ===== NAV：顶部导航栏区域 ===== -->
  <!-- <nav> 导航栏：固定贴在屏幕顶部(position:fixed top:0)，左右贴边(left/right:0)，
       层级 z-index:60 保证盖在其他内容上面；左右两端对齐布局(justify-content:space-between)；
       transition 让“滚动后背景变白”这一变化是渐变过渡而不是瞬间切换 -->
  <nav id="rp-nav" style="position:fixed; top:0; left:0; right:0; z-index:60; display:flex; align-items:center; justify-content:space-between; padding:16px clamp(20px,5vw,64px); transition:background .35s ease, box-shadow .35s ease, padding .35s ease;">
    <!-- 左上角 Logo 链接，点击跳回页面顶部(#top) -->
    <a href="#top" style="display:flex; align-items:baseline; gap:10px;">
      <!-- “雨枫”两个字：用毛笔风格字体 ZCOOL KuaiLe，字号26px -->
      <span style="font-family:'ZCOOL KuaiLe',cursive; font-size:26px; color:var(--ink); line-height:1;">雨枫</span>
      <!-- “rainple”英文：用 Fredoka 字体，字间距拉宽(letter-spacing)，颜色用主题深蓝 -->
      <span style="font-family:'Fredoka',sans-serif; font-weight:600; font-size:15px; letter-spacing:2px; color:var(--sky-deep);">rainple</span>
    </a>
    <!-- 右侧导航链接组：横排，元素间留有间距(gap) -->
    <div style="display:flex; align-items:center; gap:clamp(10px,2vw,30px); font-size:14px; font-weight:500;">
      <!-- 以下每个 <a> 是一个导航文字链接，href="#xxx" 表示点击后滚动到页面中 id="xxx" 的区块。 -->
      <a href="#about" style="position:relative; padding:6px 2px; color:var(--ink-soft);" style-hover="color:var(--ink);">关于</a>
      <a href="#design" style="padding:6px 2px; color:var(--ink-soft);" style-hover="color:var(--ink);">设定</a>
      <a href="#gallery" style="padding:6px 2px; color:var(--ink-soft);" style-hover="color:var(--ink);">画作</a>
      <a href="#fursuit" style="padding:6px 2px; color:var(--ink-soft);" style-hover="color:var(--ink);">毛照</a>
      <a href="#social" style="padding:6px 2px; color:var(--ink-soft);" style-hover="color:var(--ink);">社交</a>
      <!-- “博客 →”按钮：跳转回站点首页"/"，圆角胶囊边框样式 -->
