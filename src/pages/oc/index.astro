    <!-- 首屏主内容容器：用 grid 网格布局分成左右两列（左文字 1份 : 右图片 1.08份），居中限宽1240px -->
    <div style="position:relative; z-index:3; width:100%; max-width:1240px; margin:0 auto; display:grid; grid-template-columns:1fr 1.08fr; gap:clamp(24px,4vw,64px); align-items:center;">
      <!-- 左列：文字介绍区 -->
      <div>
        <!-- 小圆角标签“欢迎光临我的小窝”：data-reveal 不是标准属性，是自定义运行时用来标记“滚动进入视口时要淡入显示”的元素 -->
        <div data-reveal="" style="display:inline-flex; align-items:center; gap:8px; padding:7px 16px; border-radius:999px; background:rgba(255,255,255,.7); backdrop-filter:blur(6px); font-family:'Fredoka',sans-serif; font-size:12px; font-weight:600; letter-spacing:3px; color:var(--sky-deep); box-shadow:0 4px 14px rgba(111,184,232,.18);">✦ 欢迎光临我的小窝 · welcome!</div>
        <!-- <h1> 全站最大的一级标题“雨枫”：字号用 clamp() 随屏幕宽度在72px~172px间自适应缩放 -->
        <h1 data-reveal="" style="margin:22px 0 0; font-family:'ZCOOL KuaiLe',cursive; font-size:clamp(72px,12vw,172px); line-height:.9; color:var(--ink); text-shadow:0 6px 0 rgba(255,255,255,.6);">雨枫</h1>
        <!-- 英文名“rainple”副标题 -->
        <div data-reveal="" style="margin:6px 0 0; font-family:'Fredoka',sans-serif; font-weight:600; font-size:clamp(26px,4.4vw,52px); letter-spacing:8px; color:var(--sky-deep);">rainple</div>
        <!-- 自我介绍段落 <p>：中文正文 + 换行 <br> + 英文小字版本 -->
        <p data-reveal="" style="margin:26px 0 0; max-width:440px; font-size:clamp(15px,1.5vw,18px); line-height:1.9; color:var(--ink-soft);">嗨！这里是雨枫～ 一只天蓝色的小狼龙。<br><span style="font-family:'Fredoka',sans-serif; font-size:14px; letter-spacing:.3px;">Hi! I'm rainple — a sky-blue wolfdragon.</span></p>
        <!-- 两个按钮的容器：换行自动排列(flex-wrap)，按钮间留间距 -->
        <div data-reveal="" style="display:flex; flex-wrap:wrap; gap:14px; margin-top:34px;">
          <!-- 主按钮“看我长啥样”：橙色实心，跳到 #design 设定区 -->
          <a href="#design" style="padding:14px 30px; border-radius:999px; background:var(--accent); color:#fff; font-weight:600; font-size:15px; box-shadow:0 10px 24px rgba(243,128,90,.38);" style-hover="transform:translateY(-3px); box-shadow:0 16px 30px rgba(243,128,90,.48);">看我长啥样 ✦</a>
          <!-- 次按钮“翻翻相册”：白色半透明，跳到 #gallery 画作区 -->
          <a href="#gallery" style="padding:14px 30px; border-radius:999px; background:rgba(255,255,255,.85); color:var(--ink); font-weight:600; font-size:15px; box-shadow:0 8px 20px rgba(111,184,232,.22);" style-hover="transform:translateY(-3px); background:#fff;">翻翻相册 📸</a>
        </div>
        <!-- 底部两个圆点标签“狼龙·Wolfdragon”“天蓝·雪白·奶黄”：每个标签前面有个小圆点(width/height:9px的span) -->
