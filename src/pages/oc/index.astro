  <!-- ===== MARQUEE：橙色跑马灯横条 ===== -->
  <!-- aria-hidden="true" 表示对屏幕阅读器隐藏（纯装饰，不是正文内容）；整体被旋转-1.5度并放大，制造“贴纸”斜放的效果 -->
  <div class="rp-marquee-zone" aria-hidden="true">
