  <i class="rp-transition-leaf rp-transition-leaf--two"></i>
  <div class="rp-marquee-strip">
    <!-- 文字滚动轨道：宽度按内容自适应(width:max-content)，配合 marquee 动画持续向左滚动，循环26秒一轮 -->
    <div style="display:flex; width:max-content; white-space:nowrap; animation:marquee 26s linear infinite; font-family:'ZCOOL KuaiLe',cursive; font-size:21px; color:#fff; letter-spacing:1px;">
