        <div style="font-family:'Fredoka',sans-serif; font-size:13px; font-weight:600; letter-spacing:4px; color:var(--coral);">REFERENCE SHEET · 角色设定</div>
        <h2 style="margin:14px 0 0; font-family:'ZCOOL KuaiLe',cursive; font-size:clamp(34px,5vw,58px); color:var(--ink);">我的配色 &amp; 零件 🧩</h2>
      </div>

      <!-- palette：配色卡片网格，4列等宽 -->
